# Gradle
.gradle/
build/
local.properties

# Nix
result
result-*

# Android
*.apk
*.ap_
*.keystore

# openWakeWord models are content-addressed fetches staged into assets by the
# Nix build (see flake.nix); never commit the binaries themselves.
app/src/main/assets/wakeword/

# Roboto Flex is likewise staged into assets by the Nix build (from nixpkgs'
# google-fonts); never commit the font binary itself.
app/src/main/assets/fonts/

# The cross-built snapclient is staged into jniLibs by the Nix build
# (see snapclient-android.nix); never commit the binary itself.
app/src/main/jniLibs/

# IDE / editors
.idea/
*.iml
.kotlin/

# direnv
/.direnv/
