<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only used once the user opts in to updates. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!-- Only used once the user opts in to wake-word detection. The mic is not
         essential to the kiosk, so a device without one can still install. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.HearthdKiosk">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Register as a home app. Where the device allows it, this is the
                 strongest non-privileged kiosk lever: the system launches us on
                 boot, and Home returns here instead of to the stock launcher.
                 A locked-down device may not let us be selected as home; the
                 LAUNCHER filter above keeps the app reachable either way. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Receives PackageInstaller session status (e.g. the "confirm install"
             prompt when we are not the device owner). Internal only. -->
        <receiver
            android:name=".update.InstallStatusReceiver"
            android:exported="false" />

        <!-- Declared so the app can optionally be promoted to device owner
             (adb shell dpm set-device-owner …), which upgrades installs from
             prompted to silent. Dormant until provisioned. -->
        <receiver
            android:name=".update.KioskDeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
